# Copy to .env for local development:  cp .env.example .env
# docker-compose.yml reads these. Never commit the resulting .env.

POSTGRES_DB=waterbilling
POSTGRES_USER=waterbilling
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Must be at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT__SIGNINGKEY=dev-only-signing-key-replace-me-with-48-random-bytes
JWT__ISSUER=smart-water-billing
JWT__AUDIENCE=smart-water-billing-clients
JWT__ACCESSTOKENMINUTES=60

# Seed the demo dataset on startup (Development only).
SEED__ENABLED=true
SEED__ADMINEMAIL=admin@waterworks.local
SEED__ADMINPASSWORD=Admin#12345
