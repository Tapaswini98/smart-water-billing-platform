{
  "ConnectionStrings": {
    "WaterBilling": ""
  },
  "Jwt": {
    "Issuer": "smart-water-billing",
    "Audience": "smart-water-billing-clients",
    "AccessTokenMinutes": 60,
    "SigningKey": ""
  },
  "Billing": {
    "BillingOffsetHours": 5.5,
    "InvoiceNumberPrefix": "INV",
    "PaymentTermsDays": 14
  },
  "Seed": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/waterbilling-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
